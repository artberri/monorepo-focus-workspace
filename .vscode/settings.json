{
  "files.exclude": {
    "out": false,
    "node_modules": true
  },
  "search.exclude": {
    "out": true,
    "node_modules": true
  },
  "typescript.tsc.autoDetect": "off",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "oxc.typeAware": true,
  "monorepoFocusWorkspace.enableLogs": true,
  "monorepoFocusWorkspace.rootPackageJsonRelativePath": "example/package.json"
}
